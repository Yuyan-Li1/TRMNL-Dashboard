{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": ["**/.next", "**/node_modules", "**/.claude", "docs/0*.md"],
	"sortImports": {
		"newlinesBetween": false
	},
	"sortTailwindcss": {
		"stylesheet": "./src/app/globals.css"
	},
	"sortPackageJson": {
		"sortScripts": false
	}
}
